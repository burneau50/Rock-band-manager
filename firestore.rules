rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FONCTIONS DE SÉCURITÉ
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "i9FgMz7tKxZqKEa73SCKEa4lmQV2";
    }


    // ============================================================
    // MORCEAUX
    // ============================================================

    match /songs/{songId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn();

      allow update: if isAdmin()
        || (
          isSignedIn()

          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['likes', 'progress', 'status'])

          && (
            !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['status'])
            ||
            request.resource.data.status.diff(resource.data.status)
                .affectedKeys()
                .hasOnly([request.auth.uid])
          )

          && (
            !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['progress'])
            ||
            request.resource.data.progress.diff(resource.data.progress)
                .affectedKeys()
                .hasOnly([request.auth.uid])
          )

          && (
            !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['likes'])
            ||
            (
              request.resource.data.likes
                .hasOnly(resource.data.likes.concat([request.auth.uid]))
              &&
              resource.data.likes
                .hasOnly(request.resource.data.likes.concat([request.auth.uid]))
            )
          )
        );

      allow delete: if isAdmin();
    }


    // ============================================================
    // UTILISATEURS
    // ============================================================

    match /users/{userId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId;

      allow update: if isSignedIn()
        && request.auth.uid == userId;

      allow delete: if isAdmin();
    }


    // ============================================================
    // REPRÉSENTATIONS / CALENDRIER RDV
    // ============================================================

    match /representations/{representationId} {

      // Tous les utilisateurs connectés peuvent voir le calendrier.
      allow read: if isSignedIn();

      // Seul l'administrateur peut créer une date.
      allow create: if isAdmin();

      // ------------------------------------------------------------
      // MODIFICATION
      //
      // ADMIN :
      // Peut modifier librement la représentation.
      //
      // MEMBRE :
      // Peut uniquement modifier :
      //   - availability
      //   - updatedAt
      //
      // Et dans availability, il ne peut modifier que SON UID.
      // ------------------------------------------------------------

      allow update: if isAdmin()
        ||
        (
          isSignedIn()

          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['availability', 'updatedAt'])

          && request.resource.data.availability
              .diff(resource.data.availability)
              .affectedKeys()
              .hasOnly([request.auth.uid])

          && request.resource.data.availability[request.auth.uid] is bool
        );

      // Seul l'administrateur peut supprimer une date.
      allow delete: if isAdmin();
    }


    // ============================================================
    // ÉVÉNEMENTS EXISTANTS
    // ============================================================

    match /events/{eventId} {

      allow read, create, update: if isSignedIn();

      allow delete: if isAdmin();
    }


    // ============================================================
    // ANCIEN CALENDRIER
    // ============================================================

    match /calendar_events/{eventId} {

      allow read: if isSignedIn();

      allow create, update, delete: if isAdmin();
    }
  }
}
