
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "i9FgMz7tKxZqKEa73SCKEa4lmQV2";
    }

    // Morceaux
    match /songs/{songId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['likes', 'progress', 'status'])

          && (
            !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['status'])
            ||
            request.resource.data.status.diff(resource.data.status)
                .affectedKeys().hasOnly([request.auth.uid])
          )

          && (
            !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['progress'])
            ||
            request.resource.data.progress.diff(resource.data.progress)
                .affectedKeys().hasOnly([request.auth.uid])
          )

          && (
            !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['likes'])
            ||
            (
              request.resource.data.likes
                .hasOnly(resource.data.likes.concat([request.auth.uid]))
              &&
              resource.data.likes
                .hasOnly(request.resource.data.likes.concat([request.auth.uid]))
            )
          )
        );

      allow delete: if isAdmin();
    }

    // Profils utilisateurs
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId;

      allow update: if isSignedIn()
        && request.auth.uid == userId;

      allow delete: if isAdmin();
    }

    // Représentations
    match /representations/{representationId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['availability', 'updatedAt'])

          && request.resource.data.get('availability', {})
              .diff(resource.data.get('availability', {}))
              .affectedKeys()
              .hasOnly([request.auth.uid])

          && (
            !request.resource.data.get('availability', {})
                .keys().hasAny([request.auth.uid])
            ||
            request.resource.data.get('availability', {})
                .get(request.auth.uid, false) is bool
          )
        );

      allow delete: if isAdmin();
    }

    // Événements de l'ancienne collection
    match /events/{eventId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Calendrier
   match /calendar_events/{eventId} {
      allow read: if isSignedIn();

      // Les membres peuvent créer leurs propres événements.
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.get('createdBy', '') == request.auth.uid
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('date', null) is timestamp
          && request.resource.data.get('availability', {}) is map
          && request.resource.data.get('availabilityNames', {}) is map
          && request.resource.data.get('availability', {}).size() == 0
          && request.resource.data.get('availabilityNames', {}).size() == 0
        );

      // Seul l'administrateur ou le créateur peut supprimer.
      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('createdBy', '') == request.auth.uid
        );

      // L'administrateur peut modifier tous les événements.
      // Les membres ne peuvent modifier que leurs disponibilités.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'availability',
                'availabilityNames',
                'updatedAt'
              ])
          && request.resource.data.get('availability', {})
              .diff(resource.data.get('availability', {}))
              .affectedKeys()
              .hasOnly([request.auth.uid])
          && request.resource.data.get('availabilityNames', {})
              .diff(resource.data.get('availabilityNames', {}))
              .affectedKeys()
              .hasOnly([request.auth.uid])
          && (
            !request.resource.data.get('availability', {})
                .keys().hasAny([request.auth.uid])
            || request.resource.data.get('availability', {})
                .get(request.auth.uid, false) is bool
          )
          && (
            !request.resource.data.get('availabilityNames', {})
                .keys().hasAny([request.auth.uid])
            || request.resource.data.get('availabilityNames', {})
                .get(request.auth.uid, '') is string
          )
        );
    }
        // Préférences personnelles des utilisateurs
    match /user_preferences/{userId} {
      allow read: if isSignedIn()
        && request.auth.uid == userId;

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys()
            .hasOnly(['songOrder', 'summaryUserOrder', 'updatedAt'])
        && (
          !request.resource.data.keys().hasAny(['songOrder'])
          || (
            request.resource.data.songOrder is list
            && request.resource.data.songOrder.size() <= 500
          )
        )
        && (
          !request.resource.data.keys().hasAny(['summaryUserOrder'])
          || (
            request.resource.data.summaryUserOrder is list
            && request.resource.data.summaryUserOrder.size() <= 500
          )
        );

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }
  }
}
